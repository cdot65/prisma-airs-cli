name: CI

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

env:
  # pnpm/action-setup has no Node 24 major yet; force it (and any JS action) onto Node 24.
  FORCE_JAVASCRIPT_ACTIONS_TO_NODE24: 'true'

jobs:
  lint:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v5
        with:
          node-version: 24
          cache: pnpm

      - run: pnpm install --frozen-lockfile
      - run: pnpm run lint
      - run: pnpm run format:check

  typecheck:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v5
        with:
          node-version: 24
          cache: pnpm

      - run: pnpm install --frozen-lockfile
      - run: pnpm tsc --noEmit

  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5

      - uses: pnpm/action-setup@v4

      - uses: actions/setup-node@v5
        with:
          node-version: 24
          cache: pnpm

      - run: pnpm install --frozen-lockfile
      - run: pnpm test:coverage
      - run: pnpm test:release
      - run: pnpm audit:prod

  docs-build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v5
        with:
          node-version: 24
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - name: Generate API reference
        run: pnpm docs:api
      - run: pnpm -C docs-site install --frozen-lockfile
      # onBrokenLinks/onBrokenAnchors: 'throw' make this the strict build gate.
      - run: pnpm -C docs-site build

  consumer-runtime:
    runs-on: ubuntu-latest
    strategy:
      fail-fast: false
      matrix:
        node: ['20.17.0', '22.13.0', '24']
    steps:
      - uses: actions/checkout@v5
      - uses: pnpm/action-setup@v4
      - uses: actions/setup-node@v5
        with:
          node-version: ${{ matrix.node }}
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm run build
      - name: Verify DLP authentication and transfer contracts through built CLI
        run: >-
          AIRS_CLI_ENTRY="$PWD/dist/cli/index.js" pnpm exec vitest run
          tests/integration/dlp-tenant-auth.spec.ts
          tests/integration/dlp-dictionary-errors.spec.ts
          tests/integration/dlp-profile-pattern-flags.spec.ts
          tests/integration/dlp-transfer-contract.spec.ts
      - name: Verify native DLP through built public CLI
        run: node .github/scripts/verify-dlp-consumer.mjs "$PWD/dist/cli/index.js"
