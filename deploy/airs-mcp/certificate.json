{
  "apiVersion": "cert-manager.io/v1",
  "kind": "Certificate",
  "metadata": {
    "name": "airs-mcp-tls"
  },
  "spec": {
    "secretName": "airs-mcp-tls",
    "dnsNames": [
      "mcp-backend-airs.goshawks.io"
    ],
    "privateKey": {
      "rotationPolicy": "Always",
      "algorithm": "ECDSA",
      "size": 256
    },
    "issuerRef": {
      "name": "letsencrypt-prod",
      "kind": "ClusterIssuer"
    }
  }
}
