{
  "apiVersion": "v1",
  "kind": "PersistentVolumeClaim",
  "metadata": {
    "name": "airs-mcp-data",
    "labels": {
      "app.kubernetes.io/name": "airs-mcp"
    }
  },
  "spec": {
    "accessModes": [
      "ReadWriteOncePod"
    ],
    "storageClassName": "longhorn-airs-encrypted",
    "volumeMode": "Filesystem",
    "resources": {
      "requests": {
        "storage": "100Gi"
      }
    }
  }
}
