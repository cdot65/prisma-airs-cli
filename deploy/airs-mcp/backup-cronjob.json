{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
      "metadata": {
        "name": "airs-mcp-backup",
        "labels": {
          "app.kubernetes.io/name": "airs-mcp-backup-orchestrator"
        }
      },
      "automountServiceAccountToken": false
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "Role",
      "metadata": {
        "name": "airs-mcp-backup"
      },
      "rules": [
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments"
          ],
          "resourceNames": [
            "airs-mcp"
          ],
          "verbs": [
            "get"
          ]
        },
        {
          "apiGroups": [
            "apps"
          ],
          "resources": [
            "deployments/scale"
          ],
          "resourceNames": [
            "airs-mcp"
          ],
          "verbs": [
            "get",
            "patch",
            "update"
          ]
        },
        {
          "apiGroups": [
            ""
          ],
          "resources": [
            "pods"
          ],
          "verbs": [
            "get",
            "list",
            "watch"
          ]
        },
        {
          "apiGroups": [
            "batch"
          ],
          "resources": [
            "cronjobs"
          ],
          "resourceNames": [
            "airs-mcp-backup-set"
          ],
          "verbs": [
            "get"
          ]
        },
        {
          "apiGroups": [
            "batch"
          ],
          "resources": [
            "jobs"
          ],
          "verbs": [
            "create",
            "get",
            "list",
            "watch"
          ]
        }
      ]
    },
    {
      "apiVersion": "rbac.authorization.k8s.io/v1",
      "kind": "RoleBinding",
      "metadata": {
        "name": "airs-mcp-backup"
      },
      "roleRef": {
        "apiGroup": "rbac.authorization.k8s.io",
        "kind": "Role",
        "name": "airs-mcp-backup"
      },
      "subjects": [
        {
          "kind": "ServiceAccount",
          "name": "airs-mcp-backup",
          "namespace": "airs-mcp"
        }
      ]
    },
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "airs-mcp-backup",
        "labels": {
          "app.kubernetes.io/name": "airs-mcp-backup-orchestrator"
        }
      },
      "spec": {
        "schedule": "0 3 * * *",
        "timeZone": "America/Chicago",
        "concurrencyPolicy": "Forbid",
        "startingDeadlineSeconds": 600,
        "successfulJobsHistoryLimit": 14,
        "failedJobsHistoryLimit": 14,
        "jobTemplate": {
          "spec": {
            "backoffLimit": 0,
            "activeDeadlineSeconds": 3900,
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "airs-mcp-backup-orchestrator"
                }
              },
              "spec": {
                "serviceAccountName": "airs-mcp-backup",
                "automountServiceAccountToken": true,
                "enableServiceLinks": false,
                "restartPolicy": "Never",
                "hostNetwork": false,
                "hostPID": false,
                "hostIPC": false,
                "imagePullSecrets": [
                  {
                    "name": "harbor-pull"
                  }
                ],
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 65532,
                  "runAsGroup": 65532,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "containers": [
                  {
                    "name": "orchestrate",
                    "image": "kubectl",
                    "command": [
                      "/bin/sh",
                      "-c",
                      "set -eu; command -v timeout >/dev/null 2>&1 || { echo '{\"event\":\"orchestrator_preflight_failed\",\"missing\":\"timeout\"}'; exit 1; }; NS=airs-mcp; REQ=30; KGRACE=5; STOP=300; POLL=1260; RELEASE=1260; RESTORE=360; MARGIN=300; RUN=\"airs-mcp-backup-set-$(date -u +%Y%m%d%H%M%S)\"; OK=0; now() { date +%s; }; nap() { s=$(( $1 - $(now) )); if [ \"$s\" -gt 5 ]; then s=5; fi; if [ \"$s\" -gt 0 ]; then sleep \"$s\"; fi; }; kc() { d=$1; shift; r=$(( d - $(now) )); [ \"$r\" -gt 0 ] || return 124; t=$r; [ \"$t\" -gt \"$REQ\" ] && t=$REQ; timeout -k \"$KGRACE\" \"$t\" kubectl -n \"$NS\" --request-timeout=\"${t}s\" \"$@\"; }; phases() { kc \"$1\" get pod -l job-name=\"$RUN\" -o jsonpath='{range .items[*]}{.status.phase}{\"\\n\"}{end}'; }; released() { p=\"$(phases \"$1\")\" || return 1; [ -z \"$p\" ] && return 0; printf '%s\\n' \"$p\" | grep -qvE '^(Succeeded|Failed)$' && return 1; return 0; }; restore() { rc=$?; set +e; trap ':' TERM INT; svc=0; rel=0; dr=$(( $(now) + RELEASE )); while [ \"$(now)\" -lt \"$dr\" ]; do if released \"$dr\"; then rel=1; break; fi; nap \"$dr\"; done; [ \"$rel\" = 1 ] || svc=1; ds=$(( $(now) + RESTORE )); kc \"$ds\" scale deployment/airs-mcp --replicas=1 || svc=1; ready=0; while [ \"$(now)\" -lt \"$ds\" ]; do a=\"$(kc \"$ds\" get deployment airs-mcp -o jsonpath='{.status.availableReplicas}')\" || a=\"\"; if [ \"$a\" = 1 ]; then ready=1; break; fi; nap \"$ds\"; done; [ \"$ready\" = 1 ] || svc=1; if [ \"$svc\" = 0 ]; then echo '{\"event\":\"service_restored\"}'; fi; if [ \"$OK\" = 1 ] && [ \"$svc\" = 0 ] && [ \"$rc\" = 0 ]; then echo \"{\\\"event\\\":\\\"backup_set_daily_complete\\\",\\\"job\\\":\\\"$RUN\\\"}\"; fi; if [ \"$svc\" != 0 ]; then rc=1; fi; exit \"$rc\"; }; trap restore EXIT; trap 'exit 143' TERM INT; kc $(( $(now) + REQ )) scale deployment/airs-mcp --replicas=0; gone=0; d1=$(( $(now) + STOP )); while [ \"$(now)\" -lt \"$d1\" ]; do if p=\"$(kc \"$d1\" get pod -l app.kubernetes.io/name=airs-mcp -o name)\" && [ -z \"$p\" ]; then gone=1; break; fi; nap \"$d1\"; done; [ \"$gone\" = 1 ] || exit 1; kc $(( $(now) + REQ )) create job \"$RUN\" --from=cronjob/airs-mcp-backup-set; d2=$(( $(now) + POLL )); while [ \"$(now)\" -lt \"$d2\" ]; do c=\"$(kc \"$d2\" get job \"$RUN\" -o jsonpath='{range .status.conditions[*]}{.type}={.status}{\"\\n\"}{end}')\" || c=\"\"; case \"$c\" in *Complete=True*) OK=1; break ;; *Failed=True*) exit 1 ;; esac; nap \"$d2\"; done; [ \"$OK\" = 1 ] || exit 1; echo \"{\\\"event\\\":\\\"backup_set_verified\\\",\\\"job\\\":\\\"$RUN\\\"}\""
                    ],
                    "env": [
                      {
                        "name": "HOME",
                        "value": "/tmp"
                      }
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "privileged": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      },
                      "runAsNonRoot": true,
                      "runAsUser": 65532,
                      "runAsGroup": 65532
                    },
                    "resources": {
                      "requests": {
                        "cpu": "10m",
                        "memory": "32Mi"
                      },
                      "limits": {
                        "memory": "128Mi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "tmp",
                        "mountPath": "/tmp"
                      }
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "tmp",
                    "emptyDir": {
                      "medium": "Memory",
                      "sizeLimit": "16Mi"
                    }
                  }
                ],
                "terminationGracePeriodSeconds": 1980
              }
            }
          }
        }
      }
    },
    {
      "apiVersion": "batch/v1",
      "kind": "CronJob",
      "metadata": {
        "name": "airs-mcp-backup-set",
        "labels": {
          "app.kubernetes.io/name": "airs-mcp-backup"
        }
      },
      "spec": {
        "suspend": true,
        "schedule": "0 0 1 1 *",
        "concurrencyPolicy": "Forbid",
        "jobTemplate": {
          "spec": {
            "backoffLimit": 0,
            "activeDeadlineSeconds": 1200,
            "ttlSecondsAfterFinished": 1209600,
            "template": {
              "metadata": {
                "labels": {
                  "app.kubernetes.io/name": "airs-mcp-backup"
                }
              },
              "spec": {
                "automountServiceAccountToken": false,
                "enableServiceLinks": false,
                "restartPolicy": "Never",
                "hostNetwork": false,
                "hostPID": false,
                "hostIPC": false,
                "imagePullSecrets": [
                  {
                    "name": "harbor-pull"
                  }
                ],
                "securityContext": {
                  "runAsNonRoot": true,
                  "runAsUser": 65532,
                  "runAsGroup": 65532,
                  "seccompProfile": {
                    "type": "RuntimeDefault"
                  }
                },
                "initContainers": [
                  {
                    "name": "backup-set",
                    "image": "airs-mcp",
                    "args": [
                      "control-backup-set",
                      "--config",
                      "/etc/airs-mcp/config/airs-mcp.toml",
                      "--dir",
                      "/data/airs/backups",
                      "--keep",
                      "3"
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "privileged": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      },
                      "runAsNonRoot": true,
                      "runAsUser": 65532,
                      "runAsGroup": 65532
                    },
                    "resources": {
                      "requests": {
                        "cpu": "100m",
                        "memory": "256Mi"
                      },
                      "limits": {
                        "memory": "2Gi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "config",
                        "mountPath": "/etc/airs-mcp/config",
                        "readOnly": true
                      },
                      {
                        "name": "data",
                        "mountPath": "/data"
                      },
                      {
                        "name": "tmp",
                        "mountPath": "/tmp"
                      }
                    ]
                  }
                ],
                "containers": [
                  {
                    "name": "verify",
                    "image": "airs-mcp",
                    "args": [
                      "control-backup-verify",
                      "--latest-in",
                      "/data/airs/backups"
                    ],
                    "securityContext": {
                      "allowPrivilegeEscalation": false,
                      "readOnlyRootFilesystem": true,
                      "privileged": false,
                      "capabilities": {
                        "drop": [
                          "ALL"
                        ]
                      },
                      "runAsNonRoot": true,
                      "runAsUser": 65532,
                      "runAsGroup": 65532
                    },
                    "resources": {
                      "requests": {
                        "cpu": "100m",
                        "memory": "256Mi"
                      },
                      "limits": {
                        "memory": "2Gi"
                      }
                    },
                    "volumeMounts": [
                      {
                        "name": "data",
                        "mountPath": "/data",
                        "readOnly": true
                      },
                      {
                        "name": "tmp",
                        "mountPath": "/tmp"
                      }
                    ]
                  }
                ],
                "volumes": [
                  {
                    "name": "config",
                    "configMap": {
                      "name": "airs-mcp-config",
                      "defaultMode": 292
                    }
                  },
                  {
                    "name": "data",
                    "persistentVolumeClaim": {
                      "claimName": "airs-mcp-data"
                    }
                  },
                  {
                    "name": "tmp",
                    "emptyDir": {
                      "medium": "Memory",
                      "sizeLimit": "64Mi"
                    }
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "airs-mcp-backup-to-apiserver"
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "airs-mcp-backup-orchestrator"
          }
        },
        "policyTypes": [
          "Egress"
        ],
        "egress": [
          {
            "to": [
              {
                "ipBlock": {
                  "cidr": "192.168.255.10/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "192.168.255.11/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "192.168.255.12/32"
                }
              },
              {
                "ipBlock": {
                  "cidr": "192.168.255.13/32"
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 6443
              }
            ]
          }
        ]
      }
    }
  ]
}
